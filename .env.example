# Copy this file to `.env` and fill in your own values.
# CyberSphere loads these at runtime via python-dotenv (load_dotenv()).
# NEVER commit the real .env — it is gitignored on purpose.

# OpenRouter API key — powers the recon & vuln agents' LLM reasoning.
# Create one at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here
